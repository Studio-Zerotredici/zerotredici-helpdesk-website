# -----------------------------------------------------------------------------
# App - Don't add "/" at the end of the url (same in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://desk.yourdomain.com

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js) - REQUIRED
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Set this explicitly and store it in Dokploy's secret store — do not let it
# autogenerate. If it changes on redeploy, every session and encrypted token
# is invalidated.
AUTH_SECRET=
# Required with a reverse proxy in front of the app (Dokploy/Traefik).
AUTH_TRUST_HOST=true

# Google OAuth login (optional — email/password via Credentials always
# works even without this). Create a client at
# https://console.cloud.google.com/apis/credentials with authorized
# redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL) - REQUIRED
# -----------------------------------------------------------------------------
# Default: one bundled stack via docker-compose.yml (app + postgres, no
# separate Dokploy resource needed). Set credentials here — DATABASE_URL is
# computed automatically by docker-compose.yml from these three. Never
# expose 5432 publicly (the bundled postgres service already doesn't).
POSTGRES_USER=guddesk
POSTGRES_PASSWORD=
POSTGRES_DB=guddesk

# Alternative: point at an external/managed Postgres instead (Dokploy's
# managed Postgres resource, Neon, Supabase, Vercel deploys) — set
# DATABASE_URL directly and remove the `postgres` service from
# docker-compose.yml (or don't use docker-compose at all).
# DATABASE_URL='postgresql://[user]:[password]@[host]:5432/[dbname]?sslmode=require'

# -----------------------------------------------------------------------------
# Email (Resend) - required for magic-link login, password reset, and
# workspace invitations to actually deliver.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# Sender used for auth (magic link), password reset, and workspace
# invitation emails. MUST be on a domain verified in your Resend account
# (Resend > Domains > Add Domain, then add the SPF/DKIM DNS records it
# gives you). Until this is set, these three flows silently fail in
# production — the code falls back to Resend's onboarding@resend.dev
# sandbox sender, which Resend restricts to only deliver to the email
# address of the Resend account owner.
EMAIL_FROM="GudDesk <support@yourdomain.com>"

# Domain used for the reply-to address on agent notification emails
# (reply+{conversationId}@<this domain>) and for Resend's inbound-email
# webhook (POST /api/email/inbound) that turns email replies back into
# GudDesk messages. Needs its own MX/inbound routing configured in Resend —
# see https://resend.com/docs/dashboard/emails/inbound
EMAIL_REPLY_TO_DOMAIN=mail.yourdomain.com

# -----------------------------------------------------------------------------
# Real-time messaging (live chat + inbox updates) - optional but recommended
# Choose ONE of the two blocks below.
# -----------------------------------------------------------------------------

# Option A — Pusher Cloud (default for initial go-live: zero extra infra,
# just create a free app at pusher.com. SaaS; chat data leaves your
# infrastructure — swap to Option B later once Soketi is up on Dokploy).
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Option B — self-hosted Soketi (Pusher-protocol-compatible; Dokploy's
# built-in Soketi template, see DOKPLOY.md phase 2). PUSHER_APP_ID /
# NEXT_PUBLIC_PUSHER_KEY / PUSHER_SECRET must exactly match
# SOKETI_DEFAULT_APP_ID / _APP_KEY / _APP_SECRET on the Soketi service.
# Setting PUSHER_HOST / NEXT_PUBLIC_PUSHER_HOST switches to this option —
# leave both unset to use Option A above.
# PUSHER_HOST=ws.yourdomain.com
# PUSHER_PORT=443
# PUSHER_USE_TLS=true
# NEXT_PUBLIC_PUSHER_HOST=ws.yourdomain.com
# NEXT_PUBLIC_PUSHER_PORT=443
# NEXT_PUBLIC_PUSHER_FORCE_TLS=true

# If neither Pusher nor Soketi is configured, the widget/inbox fall back to
# 4-second polling — the app still works, just not real-time.

# -----------------------------------------------------------------------------
# Anthropic (AI features: reply suggestions, summaries, tagging, sentiment)
# - optional. Sends conversation content to Anthropic's US servers — leave
# unset if that's not acceptable for your data residency requirements.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Slack integration - optional
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Microsoft Clarity (analytics) - optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# -----------------------------------------------------------------------------
# NOT USED — no Stripe or S3/file-storage code exists anywhere in this repo
# (Stripe vars were inherited from the upstream template; GudDesk doesn't
# do payments or file uploads). Left out on purpose — don't bother setting
# these for GudDesk.
# -----------------------------------------------------------------------------
